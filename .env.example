# AI Security Gateway — environment template
# Copy to .env and fill in. NEVER commit your real .env.
# Local dev works with only the values in the "Minimum dev setup" section.

# ---- Minimum dev setup ----
APP_ENV=development
SECRET_KEY=<32+ random chars; encrypts fields at rest & signs dev tokens>
# Optional dedicated field-encryption key (v2). Unset = derived from SECRET_KEY (v1).
# DATA_ENCRYPTION_KEY=<32+ random chars>

# ---- Authentication (dev defaults keep the dashboard open) ----
REQUIRE_AUTH=false
REQUIRE_ADMIN_AUTH=false
AUTH_MODE=api_key            # api_key | jwt
API_KEY=<32+ random chars>   # required if REQUIRE_AUTH=true and AUTH_MODE=api_key
ADMIN_API_KEY=<32+ random chars, different from API_KEY>
# JWT mode: JWT_SECRET_KEY=<32+ chars HS256> or RS256 keypair (JWT_PUBLIC_KEY)

# ---- Provider access (dashboard-configurable; stored as env://NAME references) ----
# The built-in mock provider needs no key and makes no network calls.
GEMINI_API_KEY=
# OPENAI_KEY= / ANTHROPIC_KEY= (or set via Vault: SECRETS_BACKEND=vault)
PROVIDER_EGRESS_ALLOWLIST=generativelanguage.googleapis.com,api.openai.com,api.anthropic.com
WEBHOOK_EGRESS_ALLOWLIST=hooks.example.com

# ---- Database / queue (SQLite+in-process by default; Postgres/Redis for parity & prod) ----
DATABASE_URL=sqlite:///./ai_security.db
# DATABASE_URL=postgresql+psycopg://gateway:PASSWORD@localhost:5432/ai_security
# REDIS_URL=redis://:PASSWORD@localhost:6379/0

# ---- Production (APP_ENV=production enforces all of these at boot) ----
# DATABASE_URL must be Postgres, REQUIRE_AUTH/REQUIRE_ADMIN_AUTH=true,
# PROVIDER_EGRESS_ALLOWLIST + WEBHOOK_EGRESS_ALLOWLIST required,
# SECRETS_BACKEND=vault + HTTPS VAULT_ADDR + VAULT_TOKEN required,
# HITL_EMAIL must be a real recipient, REDIS_URL required.
